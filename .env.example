# Copy to `.env` in this folder (never commit `.env`).
# Supabase → Project Settings → API

# "Project URL" at the top of the API page
EXPO_PUBLIC_SUPABASE_URL=https://yhfqlvblqlpacjdkltfi.supabase.co

# MUST be one of these (NOT service_role, NOT sb_secret_*):
# • "Legacy" tab → anon / public → long JWT starting with eyJ...
# • OR "API Keys" tab → Publishable key → sb_publishable_...
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS builds: add the SAME two variable names in
# https://expo.dev → your project → Environment variables
# → scope "production" (and "preview" if you use that profile).
# Put the anon/publishable value in EXPO_PUBLIC_SUPABASE_ANON_KEY there.

# If a service_role JWT was ever committed to git or eas.json, open Supabase
# → Settings → API → rotate the service_role key immediately.

# ── "Network request failed" / AuthRetryableFetchError in Expo Go ─────────────
# --tunnel only loads JS from your PC; Supabase calls go Phone → Internet.
# 1) Same WiFi: run `npx expo start` (no --tunnel) and open the LAN URL in Expo Go.
# 2) On the phone browser, open your project URL; you should reach Supabase (not timeout).
# 3) Turn off VPN / Private DNS / ad-block DNS; check Supabase dashboard (project not paused).
